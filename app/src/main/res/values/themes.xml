<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.DyScraper" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryDark">@color/primary_variant</item>
        <item name="colorAccent">@color/accent</item>
        <item name="android:windowBackground">@color/background</item>
        <!-- 系统状态栏（顶部通知栏那条）：跟随顶栏用纯白，图标转深色（minSdk 26，无需分目录） -->
        <item name="android:statusBarColor">@color/top_bar_background</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <style name="AppInfoLabel">
        <item name="android:layout_width">76dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">13sp</item>
    </style>

    <style name="AppInfoValue">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textIsSelectable">true</item>
        <item name="android:textSize">13sp</item>
    </style>
</resources>